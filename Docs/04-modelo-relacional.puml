@startuml
title Modelo Relacional - Base de datos de leads (Supabase / Postgres)

skinparam monochrome true
skinparam backgroundColor white
skinparam ClassBackgroundColor white
skinparam ParticipantBackgroundColor white
skinparam ActorBackgroundColor white
skinparam DatabaseBackgroundColor white
skinparam ActivityBackgroundColor white
skinparam EntityBackgroundColor white
skinparam NoteBackgroundColor white
skinparam LegendBackgroundColor white
skinparam SequenceGroupBackgroundColor white
skinparam SequenceDividerBackgroundColor white
hide circle
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontSize 13
skinparam linetype ortho
hide circle

entity "LEADS" as leads {
  * cedula : TEXT <<PK>>
  --
  * nombre : TEXT
  apellido : TEXT
  correo : TEXT
  * telefono : TEXT
  * creado_en : TIMESTAMPTZ
  * actualizado_en : TIMESTAMPTZ
}

entity "CONSULTAS" as consultas {
  * id : BIGINT <<PK>>
  --
  * cedula : TEXT <<FK>>
  * respuestas : JSONB
  * resultados : JSONB
  * creado_en : TIMESTAMPTZ
}

entity "INTERESES" as intereses {
  * id : BIGINT <<PK>>
  --
  * cedula : TEXT <<FK>>
  consulta_id : BIGINT <<FK>>
  * proyecto : TEXT
  * intencion_compra : BOOLEAN
  fecha_seguimiento : TEXT
  temperatura_lead : TEXT
  * creado_en : TIMESTAMPTZ
  * actualizado_en : TIMESTAMPTZ
}

leads ||--o{ consultas : "llena el cuestionario"
leads ||--o{ intereses : "se interesa en"
consultas |o--o{ intereses : "origina"

legend right
  * = NOT NULL
  PK = llave primaria
  FK = llave foránea
  Las tablas están cerradas (Row Level Security, sin políticas):
  el navegador solo llama a 4 funciones PL/pgSQL
  guardar_consulta, buscar_resultados,
  marcar_interes y marcar_intencion.
  El catálogo de 96 proyectos no está en la base:
  vive en archivos JSON del motor.
endlegend

@enduml
