@startuml
title Diagrama de Procesos - Leadify: de visitante anónimo a cita agendada con el asesor

skinparam monochrome true
skinparam backgroundColor white
skinparam ClassBackgroundColor white
skinparam ParticipantBackgroundColor white
skinparam ActorBackgroundColor white
skinparam DatabaseBackgroundColor white
skinparam ActivityBackgroundColor white
skinparam EntityBackgroundColor white
skinparam NoteBackgroundColor white
skinparam LegendBackgroundColor white
skinparam SequenceGroupBackgroundColor white
skinparam SequenceDividerBackgroundColor white
hide circle
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontSize 13
skinparam ActivityFontSize 13
skinparam ArrowColor black

|Comprador|
start
:Abrir el formulario de la constructora;
:Llenar el carné\n(nombre, correo, teléfono, cédula)\ny aceptar el tratamiento de datos;

|Sistema Leadify|
:Buscar la cédula y el teléfono en la base de leads;
if (¿Tiene una consulta guardada?) then (sí)
  :Restaurar las recomendaciones guardadas;
else (no)
  |Comprador|
  :Responder las 7 preguntas\n(el plano del apartamento se arma en pantalla);
  note right
    Zona, tipo de vivienda (VIS / No VIS),
    ingresos, personas a cargo, habitaciones,
    zonas comunes y edad.
  end note

  |Sistema Leadify|
  :Enviar el perfil al motor (POST /api/recomendar);
  if (¿El motor respondió?) then (sí)
    :Filtrar por localidad (expandir a vecinas),\ncalcular Nearest Neighbors\ny reordenar por capacidad de pago;
    :Devolver hasta 18 proyectos\ncon su porcentaje de compatibilidad;
    :Guardar la consulta\n(si la lista no está vacía);
  else (no)
    |Comprador|
    :Reintentar o pedir\nlas recomendaciones aproximadas;
    |Sistema Leadify|
    :Mostrar el catálogo local\nmarcado como "orden aproximado";
  endif
endif

|Comprador|
:Revisar los proyectos y elegir uno;

|Sistema Leadify|
:Registrar el interés en el proyecto;

|Comprador|
:Pedir la llamada de Manuela;

|Sistema Leadify|
if (¿Es un móvil colombiano válido?) then (no)
  :Rechazar con el mensaje\n"número no válido";
  |Comprador|
  :Corregir el teléfono;
  |Sistema Leadify|
else (sí)
endif
:Enviar los datos del lead y del proyecto a Dapta;

|Manuela (Dapta)|
:Llamar al comprador;
:Confirmar datos y resolver dudas;
if (¿Aceptó agendar una cita?) then (sí)
  :Acordar fecha de seguimiento con el asesor;
else (no)
  :Registrar objeción principal\ny temperatura del lead;
endif
:Enviar el análisis post-llamada\n(webhook);

|Sistema Leadify|
:Guardar el resultado de la llamada;
:Mostrar el resumen al comprador\n(consulta cada 4 s hasta 45 intentos);
if (¿Llegó fecha de seguimiento?) then (sí)
  :Marcar intención de compra = verdadero;

  |Asesor comercial|
  :Recibir el lead con la cita ya puesta;
  :Atender la cita con el comprador;
else (no)
  |Sistema Leadify|
  :Dejar intención de compra = falso\n(el lead sigue en maduración);
endif

stop
@enduml
