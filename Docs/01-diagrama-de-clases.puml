@startuml
title Diagrama de Clases - Leadify: del cuestionario a la cita con el asesor

skinparam monochrome true
skinparam backgroundColor white
skinparam ClassBackgroundColor white
skinparam ParticipantBackgroundColor white
skinparam ActorBackgroundColor white
skinparam DatabaseBackgroundColor white
skinparam ActivityBackgroundColor white
skinparam EntityBackgroundColor white
skinparam NoteBackgroundColor white
skinparam LegendBackgroundColor white
skinparam SequenceGroupBackgroundColor white
skinparam SequenceDividerBackgroundColor white
hide circle
skinparam shadowing false
skinparam roundcorner 8
skinparam classAttributeIconSize 0
skinparam defaultFontSize 13
skinparam ArrowFontSize 12
skinparam nodesep 70
skinparam ranksep 90
hide empty members

enum TipoVivienda <<enumeration>> {
  VIS
  NO_VIS
}

enum EstadoCalificacion <<enumeration>> {
  LISTO_PARA_ASESOR
  EN_MADURACION
}

class Lead {
  -cedula : String
  -nombre : String
  -apellido : String
  -correo : String
  -telefono : String
  -creadoEn : Date
  -actualizadoEn : Date
  +guardarConsulta(respuestas : Map, resultados : List<Recomendacion>) : int
  +buscarResultados(cedula : String, telefono : String) : Consulta
}

class Consulta {
  -idConsulta : int
  -respuestas : JSON
  -resultados : JSON
  -creadoEn : Date
  +restaurar() : List<Recomendacion>
}

class Interes {
  -idInteres : int
  -proyecto : String
  -intencionCompra : boolean
  -fechaSeguimiento : String
  -temperaturaLead : String
  -creadoEn : Date
  -actualizadoEn : Date
  +marcarInteres() : int
  +marcarIntencion(fecha : String, temperatura : String) : boolean
}

class FormularioUsuario {
  -nombres : String
  -apellidos : String
  -correo : String
  -telefono : int
  -afiliado : int
  -tipoVivienda : int
  -salario : int
  -personasACargo : int
  -edad : int
  -localidad : int
  -numeroHabitaciones : int
  -piso : int
  -zonasComunes : List<String>
  -barrio : String
}

class MotorRecomendacion {
  +TOP_N : int = 18
  +recomendar(formulario : FormularioUsuario) : List<Recomendacion>
  -primerFiltro() : List<Proyecto>
  -nearestNeighbors() : List<Proyecto>
  -cotaMinimaBG() : List<Proyecto>
  -postArreglos() : List<Recomendacion>
}

class Recomendacion {
  -posicion : int
  -compatibilidad : int
  -score : double
  -cuotaMensualEstimadaCop : double
  -anosDePago : double
  -alcanzable : boolean
  -zonasEnComun : List<String>
  -distanciaKm : double
}

class Proyecto {
  -idProyecto : int
  -nombreProyecto : String
  -tipoVivienda : TipoVivienda
  -localidad : String
  -barrio : String
  -direccion : String
  -precioDesdeCop : double
  -areaConstruidaM2 : double
  -habitaciones : int
  -aplicaSubsidioCaja : boolean
  -zonasComunes : List<String>
  -urlFicha : String
}

class Constructora {
  -nombre : String
}

class CalificacionLead {
  -score : int
  -estado : EstadoCalificacion
  -etiqueta : String
  -notas : List<String>
  +READY_THRESHOLD : int = 60
  +calcular(respuestas : Map, mejorMatch : int) : CalificacionLead
}

class SolicitudLlamada {
  -nombre : String
  -telefono : String
  -afiliado : boolean
  -rangoIngreso : String
  -edad : int
  -personasACargo : int
  -entornoDeseado : String
}

class ApartamentoLlamada {
  -nombreProyecto : String
  -localidad : String
  -tipoVivienda : String
  -precioDesdeCop : double
  -cuotaMensualEstimadaCop : double
  -aplicaSubsidioCaja : boolean
}

class ServicioLlamadas {
  -dirigidoA : String = "Dapta (agente Manuela)"
  +normalizarTelefonoE164(telefono : String) : String
  +llamar(solicitud : SolicitudLlamada) : String
  +recibirResultado(webhook : JSON) : void
  +consultarResultado(telefono : String) : ResultadoLlamada
}

class ResultadoLlamada {
  -listo : boolean
  -recibidoEn : Date
  -temperaturaLead : String
  -resumenLlamada : String
  -recomendacionAsesor : String
  -estadoDelLead : String
  -nivelDeUrgencia : String
  -presupuestoConfirmado : String
  -fechaDeSeguimiento : String
  -objecionPrincipal : String
  +citaAgendada() : boolean
}

Lead "1" --> "0..*" Consulta : realiza
Lead "1" --> "0..*" Interes : muestra
Lead "1" --> "0..*" SolicitudLlamada : pide

Consulta "1" *-- "0..*" Recomendacion : contiene
Consulta "0..*" ..> "1" FormularioUsuario : <<use>> respuestas
Interes "0..*" --> "0..1" Consulta : originado en
Interes "0..*" --> "1" Proyecto : sobre

MotorRecomendacion ..> FormularioUsuario : <<use>>
MotorRecomendacion "1" --> "0..*" Recomendacion : genera
Recomendacion "0..*" --> "1" Proyecto : recomienda
Proyecto "1..*" -- "1..*" Constructora : publica
Proyecto --> TipoVivienda

CalificacionLead --> EstadoCalificacion
CalificacionLead ..> Recomendacion : <<use>> mejor match
Consulta "1" ..> "0..1" CalificacionLead : <<use>> clasifica

SolicitudLlamada "1" *-- "1" ApartamentoLlamada : apartamento
ServicioLlamadas ..> SolicitudLlamada : <<use>>
ServicioLlamadas "1" --> "0..*" ResultadoLlamada : guarda por teléfono
ResultadoLlamada ..> Interes : <<use>> fecha de seguimiento

@enduml
